# Python caches
__pycache__/
*.py[cod]

# Secrets: never commit them
.env

# Build outputs of the streaming monitors (host/streaming/Makefile)
/host/streaming/.output/
/host/streaming/execmon
/host/streaming/filemon
/host/streaming/hostmon
/host/streaming/modelmon

# bf-p4c output directories, wherever a program is compiled
*.tofino/

# Hardware benchmark runs: per-command logs, P4 builds, pcaps, register dumps
# and captures. They stay on disk; docs/p4_perf.md is the summary.
# Exception: the per-probe latencies of the Section 4.1/5.5 hairpin runs
# (collect_reports.py output: packet_latencies.csv and summary.json).
/switch/results/**
!/switch/results/**/
!/switch/results/*/*_hairpin_r[0-9]/packet_latencies.csv
!/switch/results/*/*_hairpin_r[0-9]/summary.json
/switch/plots/

# Outputs that scripts write to the working directory
/benign_ls_clean.csv
/process_summary.csv
/ctu13_s13_peak10.csv
/synthetic_testers.csv
/hybrid_labels.csv
/hybrid_windows.csv
/indexes_unique.txt
/hybrid_dataset_workdir/

# Local captures and test artifacts
*.log
/test_ebpf_logs/
/veth_sw_ext
/veth_sw_int
# The extra captures unpacked from experiments/captures/cohort-extra.tar.gz (771 MB; docs/PC1.md Part 4)
/experiments/captures/cohort-extra/
